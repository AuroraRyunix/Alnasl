msgstr "%{list} en %{last}"

#: lib/alnasl_web/live/setup_live.ex:1369
#, elixir-autogen, elixir-format
msgid "All versions and what changed"
msgstr "Alle versies en wat er veranderd is"

#: lib/alnasl_web/live/setup_live.ex:1439
#, elixir-autogen, elixir-format
