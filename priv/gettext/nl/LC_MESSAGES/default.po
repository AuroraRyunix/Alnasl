msgid "That is not a whole connect code: the part after the # is missing. Copy the whole line OpenPairings shows, from https:// to the end."
msgstr "Dat is geen volledige koppelcode: het deel na de # ontbreekt. Kopieer de hele regel die OpenPairings toont, van https:// tot het einde."

#: lib/alnasl_web/live/setup_live.ex:864
#, elixir-autogen, elixir-format
msgid "The boards follow round %{n}."
msgstr "De borden volgen ronde %{n}."

#: lib/alnasl_web/link_words.ex:28
