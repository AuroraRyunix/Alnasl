# The tests read files byte for byte (heredocs, the .po catalogue, capture
# fixtures): a checkout with CRLF line endings fails three of them.
* text=auto eol=lf
*.pyc binary
# cmd reads a batch file with LF endings until the day it does not.
*.bat text eol=crlf
*.bat.eex text eol=crlf
*.ico binary
# Vendored contracts are the providers' bytes, compared byte for byte by
# `mix contracts.check`: git leaves them exactly as they came.
priv/contracts/vendor/** -text
