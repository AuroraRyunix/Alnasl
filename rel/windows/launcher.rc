/*
 * Resources of Alnasl.exe, compiled by `zig rc` from build_launcher.ps1.
 *
 * launcher_version.h is written by that script from the version in mix.exs
 * and is not committed.
 */

#include "launcher_version.h"

1 ICON "Alnasl.ico"

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION ALNASL_VER_MAJOR, ALNASL_VER_MINOR, ALNASL_VER_PATCH, 0
PRODUCTVERSION ALNASL_VER_MAJOR, ALNASL_VER_MINOR, ALNASL_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Alnasl"
            VALUE "FileDescription", "Alnasl - live chess boards"
            VALUE "FileVersion", ALNASL_VER_STRING
            VALUE "InternalName", "Alnasl"
            VALUE "OriginalFilename", "Alnasl.exe"
            VALUE "ProductName", "Alnasl"
            VALUE "ProductVersion", ALNASL_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
