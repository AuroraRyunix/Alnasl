#!/bin/sh
# Read by bin/alnasl before the runtime starts.
#
# Erlang distribution is off unless somebody asks for it. A release starts
# it by default: epmd on every interface, a node listener beside it, and a
# cookie that ships inside the download and is therefore the same on every
# box. The hall's network is not the place for that, and nothing here needs
# it - the unit stops the program with a signal, not a remote call.
#
# The price: `bin/alnasl stop|restart|remote|rpc` have no node to talk to.
# RELEASE_DISTRIBUTION=sname before starting buys them back, for a session.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
