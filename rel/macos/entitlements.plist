<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only by rel/macos/sign_and_notarize.sh, i.e. only once a Developer ID
  certificate exists. Notarisation requires the hardened runtime, and the
  hardened runtime forbids three things the BEAM needs:

    allow-jit                          the BEAM's JIT writes machine code
    allow-unsigned-executable-memory   ...and older paths in it do so without MAP_JIT
    disable-library-validation         NIFs (SQLite) and the serial port program are
                                       loaded with dlopen from the release
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
